# ============================================================
# .gitignore — Hugo López y Hnos. S.A.
# Archivos que NUNCA deben subirse al repositorio
# ============================================================

# Archivos de configuración con datos sensibles
.env
.env.local
.env.*.local
*.key
*.pem
secrets.*
config.secret.*

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Editores de código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Node.js (por si se agrega alguna herramienta de build en el futuro)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Archivos temporales y de log
*.log
*.tmp
*.temp
tmp/
temp/

# Archivos de backup
*.bak
*.backup
*.orig

# Archivos comprimidos (subir las imágenes directamente, no en ZIP)
*.zip
*.tar
*.tar.gz
*.rar

# Carpeta de build (si se agrega en el futuro)
dist/
build/
.cache/
